{
  "name": "dsh-apple-liquid-glass",
  "version": "0.2.1",
  "description": "Apple-style liquid glass for the DSH web client: composer with a flowing blue edge glow, per-surface scope switches, sidebar controls, model picker and send button, plus a handwritten hello opening animation. Intensity, scope and splash are configured in the plugin's Settings section; the page background stays untouched.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/icon.svg",
  "files": [
    "assets/fonts",
    "assets/icon.svg",
    "cordis.patch.yml",
    "docs",
    "lib",
    "LICENSE",
    "preview/harness.html",
    "README.md",
    "README.zh.md",
    "scripts",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "liquid-glass",
    "glassmorphism",
    "apple",
    "ios"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-0"
  },
  "license": "MIT",
  "author": "CTY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyuec11-design/dsh-apple-liquid-glass.git"
  },
  "homepage": "https://github.com/tianyuec11-design/dsh-apple-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/tianyuec11-design/dsh-apple-liquid-glass/issues"
  }
}
